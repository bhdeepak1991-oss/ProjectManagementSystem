@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Features/shared/ProjectSelectionLayout.cshtml";
}

@model IEnumerable<PMS.Features.Project.ViewModels.ProjectViewModel>

<div class="container-fluid">
    <section class="content">


        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header with-border">
                        <h3 class="box-title">Please select Project to Proceed</h3>
                        <div class="box-tools pull-right">
                            <button class="btn btn-success" onclick="fn_createProject()">Create Project</button>

                            <button onclick="fn_copyProject()" class="btn btn-primary">Copy Project</button>

                            <button class="btn btn-warning">Delete Project</button>

                            <button class="btn btn-danger">Archive Project</button>
                        </div>
                    </div>
                    <div class="box-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-12">

                                    <table id="documentTable" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>Select</th>
                                                <th>
                                                    Project Name
                                                </th>
                                                <th>
                                                    Start Date
                                                </th>
                                                <th>
                                                    End Date
                                                </th>
                                                <th>
                                                    Project Head
                                                </th>
                                                <th>
                                                    Delivery Head
                                                </th>
                                                <th>
                                                    Client Name
                                                </th>
                                                <th>
                                                    Status
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var data in Model)
                                            {
                                                <tr>
                                                    <td>
                                                        <input type="radio"
                                                               name="SelectedProject"
                                                               value="@data.Id" data-name="@data.Name" />
                                                    </td>
                                                    <td>
                                                        <a  asp-action="SelectProject" asp-controller="Dashboard" asp-route-projectId="@data.Id">@data.Name</a>
                                                    </td>
                                                    <td>@data.ProjectStartDate?.ToLongDateString()</td>
                                                    <td>@data.ProjectEndDate?.ToLongDateString()</td>
                                                    <td>@data.ProjectHead</td>
                                                    <td>@data.DeliveryHead</td>
                                                    <td>@data.ClientName</td>
                                                    <td>@data.ProjectStatus</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        @await Html.PartialAsync("~/Features/shared/PmsModalPopUp.cshtml")

    </section>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
<script>
    function fn_copyProject() {

        var selectedRadio = document.querySelector(
            'input[name="SelectedProject"]:checked'
        );

        if (!selectedRadio) {
            alert("Please select a project.");
            return;
        }

        var selectedValue = selectedRadio.value;

        var projectName = selectedRadio.getAttribute("data-name");


        $.get("/Dashboard/CopyProject", { projectId : selectedValue}, function(resp) {

            $("#divData").html(resp);
            $("#pmModalPopUp").modal('show');
            $("#pmModalPopUpTitle").html("<i class='fa fa-copy'></i> Copy Project From  ("+ projectName+')');
        });
    }

    function fn_createProject() {

        $.get("/Dashboard/CreateProject", function(resp) {
        
            $("#divData").html(resp);
            $("#pmModalPopUp").modal('show');
            $("#pmModalPopUpTitle").html("<i class='fa fa-add'></i> Create new Project");
        });


    }

    function fn_CloseModal() {
        $("#pmModalPopUp").modal('hide');
    }

</script>